{
  "name": "grid-battle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test shared/test/*.test.ts client/test/*.test.ts server/test/*.test.ts",
    "dev:client": "npm run dev --workspace @grid-game/client",
    "dev:server": "npm run start --workspace @grid-game/server",
    "build:client": "npm run build --workspace @grid-game/client"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
